<?xml version="1.0" encoding="utf-8"?>
<!--
    Release network security configuration.

    Cleartext traffic is permitted because MemosYou connects to self-hosted
    Memos servers which may run on local networks without HTTPS configured.

    User-installed CA certificates are NOT trusted. This prevents
    corporate/ISP MITM proxies from intercepting traffic and protects
    the user's access token from being leaked.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
